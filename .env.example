# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive (OAuth2 — recommended)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Drive (service account JSON — alternative, requires org policy to allow key creation)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Higgsfield
HIGGSFIELD_API_KEY=your-higgsfield-api-key
HIGGSFIELD_API_URL=https://api.higgsfield.ai/v1

# Slack (incoming webhook URL)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cron security
CRON_SECRET=your-random-cron-secret
